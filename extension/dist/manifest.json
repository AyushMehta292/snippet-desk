{
  "manifest_version": 3,
  "name": "Snippet Desk",
  "version": "1.0.0",
  "description": "Types saved snippets into the field you are writing in.",
  "permissions": ["storage", "tabs", "windows"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Snippet Desk"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-bridge.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle",
      "match_about_blank": true
    }
  ]
}
